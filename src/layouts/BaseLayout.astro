---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { visitorLog } from '../lib/site';

interface Props { title: string; description: string; }
const { title, description } = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.pathname;
// twitter:card below asks for a large image, so one has to exist or a shared
// link renders an empty card. Regenerate with `npm run build:og`.
const ogImage = Astro.site ? new URL('/og.png', Astro.site).href : '/og.png';
const logCode = visitorLog.goatcounter.trim();
const liveHost = Astro.site?.hostname ?? '';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />
  <meta property="og:site_name" content="Eason Han" />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="Eason Han — I build the products I pitch." />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:image" content={ogImage} />
  <link rel="sitemap" href="/sitemap-index.xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist:wght@400..600&family=Geist+Mono:wght@400;500&family=Newsreader:ital,opsz,wght@0,6..72,400..600;1,6..72,400..600&display=swap" />
  <meta name="theme-color" content="#E4E8E5" media="(prefers-color-scheme: light)" />
  <meta name="theme-color" content="#0E1412" media="(prefers-color-scheme: dark)" />
  <!-- Applied before first paint so an explicit theme choice never flashes the other
       palette. `js` lets controls that only work with script stay hidden without it. -->
  <script is:inline>
    document.documentElement.classList.add('js');
    try {
      var t = localStorage.getItem('theme');
      if (t === 'dark' || t === 'light') document.documentElement.setAttribute('data-theme', t);
    } catch (e) {}
  </script>
  <!-- Visitor log: counts visits without cookies, on the live site only.
       A link tagged ?from=name is recorded as where the visit came from.
       Nothing loads until a site code is set in src/lib/site.ts. -->
  {logCode && (
    <script is:inline define:vars={{ logCode, liveHost }}>
      if (location.hostname === liveHost) {
        var tag = new URLSearchParams(location.search).get('from');
        window.goatcounter = { referrer: function () { return tag || document.referrer; } };
        var s = document.createElement('script');
        s.async = true;
        s.src = 'https://gc.zgo.at/count.js';
        s.setAttribute('data-goatcounter', 'https://' + logCode + '.goatcounter.com/count');
        document.head.appendChild(s);
        // Three actions are logged by name: any element carrying data-log.
        document.addEventListener('click', function (e) {
          var el = e.target && e.target.closest ? e.target.closest('[data-log]') : null;
          if (el && window.goatcounter && window.goatcounter.count) {
            window.goatcounter.count({ path: el.getAttribute('data-log'), title: el.getAttribute('data-log'), event: true });
          }
        });
      }
    </script>
  )}
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <Nav />
  <main id="main"><slot /></main>
  <Footer />

  <script>
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const btn = document.getElementById('theme-toggle');
    btn?.addEventListener('click', () => {
      const root = document.documentElement;
      let cur = root.getAttribute('data-theme');
      if (!cur) cur = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      const next = cur === 'dark' ? 'light' : 'dark';
      root.setAttribute('data-theme', next);
      try { localStorage.setItem('theme', next); } catch (e) {}
    });

    // Content fades in once as it enters. Nothing else on the page moves.
    const targets = Array.from(document.querySelectorAll<HTMLElement>('.rv'));
    if ('IntersectionObserver' in window && !reduce && targets.length) {
      document.documentElement.classList.add('js-rv');
      const ro = new IntersectionObserver((entries) => {
        for (const e of entries) {
          if (e.isIntersecting) { e.target.classList.add('in'); ro.unobserve(e.target); }
        }
      }, { rootMargin: '0px 0px -8% 0px', threshold: 0 });
      targets.forEach((el, i) => {
        // A stagger for the reveal only. An inline transition-delay would also hold
        // back every other transition on the element — a theme switch included.
        el.style.setProperty('--d', `${Math.min(i % 4, 3) * 60}ms`);
        ro.observe(el);
      });
    }
  </script>
</body>
</html>
