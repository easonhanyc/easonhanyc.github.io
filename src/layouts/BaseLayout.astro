---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props { title: string; description: string; }
const { title, description } = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.pathname;
// twitter:card below asks for a large image, so one has to exist or a shared
// link renders an empty card. Regenerate with `npm run build:og`.
const ogImage = Astro.site ? new URL('/og.png', Astro.site).href : '/og.png';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />
  <meta property="og:site_name" content="Eason Han" />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="Eason Han — product thinking, and the hands to build it" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:image" content={ogImage} />
  <link rel="sitemap" href="/sitemap-index.xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist:wght@300..700&family=Geist+Mono:wght@400;500&display=swap" />
  <meta name="theme-color" content="#E4E8E5" media="(prefers-color-scheme: light)" />
  <meta name="theme-color" content="#0E1412" media="(prefers-color-scheme: dark)" />
  <!-- Applied before first paint so an explicit theme choice never flashes the other
       palette. `js` lets controls that only work with script stay hidden without it. -->
  <script is:inline>
    document.documentElement.classList.add('js');
    try {
      var t = localStorage.getItem('theme');
      if (t === 'dark' || t === 'light') document.documentElement.setAttribute('data-theme', t);
    } catch (e) {}
  </script>
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <div class="readbar" aria-hidden="true"></div>
  <Nav />
  <main id="main"><slot /></main>
  <Footer />

  <script>
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const hasIO = 'IntersectionObserver' in window;

    const btn = document.getElementById('theme-toggle');
    btn?.addEventListener('click', () => {
      const root = document.documentElement;
      let cur = root.getAttribute('data-theme');
      if (!cur) cur = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      const next = cur === 'dark' ? 'light' : 'dark';
      root.setAttribute('data-theme', next);
      try { localStorage.setItem('theme', next); } catch (e) {}
    });

    // A soft light follows the cursor across whichever tile it is over.
    // Pointer devices only; one rAF per frame however fast the mouse moves.
    if (window.matchMedia('(hover: hover)').matches && !reduce) {
      let raf = 0, ev: PointerEvent | null = null;
      addEventListener('pointermove', (e) => {
        ev = e;
        if (raf) return;
        raf = requestAnimationFrame(() => {
          raf = 0;
          const t = (ev!.target as Element | null)?.closest?.<HTMLElement>('.tile');
          if (!t) return;
          const r = t.getBoundingClientRect();
          t.style.setProperty('--mx', `${ev!.clientX - r.left}px`);
          t.style.setProperty('--my', `${ev!.clientY - r.top}px`);
        });
      }, { passive: true });
    }

    const targets = Array.from(document.querySelectorAll<HTMLElement>('.rv, .rv-w, .plate, .prose .dg'));
    if (hasIO && !reduce && targets.length) {
      document.documentElement.classList.add('js-rv');

      // Stroked geometry inside a figure draws itself along its own length.
      // Measured here rather than hand-authored so a diagram can be edited freely.
      for (const fig of document.querySelectorAll('.plate svg, .prose .dg svg')) {
        for (const el of fig.querySelectorAll<SVGGeometryElement>('path, line, polyline, circle, ellipse, rect')) {
          const stroke = getComputedStyle(el).stroke;
          if (!stroke || stroke === 'none') continue;
          let len = 0;
          try { len = el.getTotalLength(); } catch (e) { continue; }
          if (len < 8 || len > 6000) continue;          // skip dots and outliers
          el.setAttribute('data-draw', '');
          el.style.setProperty('--len', String(Math.ceil(len)));
        }
      }

      const ro = new IntersectionObserver((entries) => {
        for (const e of entries) {
          if (e.isIntersecting) { e.target.classList.add('in'); ro.unobserve(e.target); }
        }
      }, { rootMargin: '0px 0px -12% 0px', threshold: 0 });
      targets.forEach((el, i) => {
        // A stagger for the reveal only. An inline transition-delay would also hold
        // back every other transition on the element — a theme switch included.
        el.style.setProperty('--d', `${Math.min(i % 6, 5) * 60}ms`);
        ro.observe(el);
      });
    }
  </script>
</body>
</html>
