---
const path = Astro.url.pathname;
const is = (p: string) => path === p || (p !== '/' && path.startsWith(p));
// The home page's opening section already says this, right under the nav.
const home = path === '/';
const links = [
  ['/work', 'Work'],
  ['/artifacts', 'Artifacts'],
  ['/about', 'About'],
];
---
<!-- A floating pill rather than a full-width bar, and the page shows
     through its frosted glass. -->
<header class="hdr">
  <nav class="pill" aria-label="Primary">
    <a class="sig" href="/">Eason Han</a>
    {!home && <span class="st"><span class="dot"></span>Open to Summer 2027 PM internships</span>}
    <div class="navlinks">
      {links.map(([href, label]) => (
        <a href={href} aria-current={is(href) ? 'page' : undefined}>{label}</a>
      ))}
    </div>
    <button class="themebtn" id="theme-toggle" type="button" aria-label="Switch colour theme">
      <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true" focusable="false">
        <circle cx="10" cy="10" r="7.25" fill="none" stroke="currentColor" stroke-width="1.4"/>
        <path d="M10 2.75a7.25 7.25 0 0 1 0 14.5z" fill="currentColor"/>
      </svg>
    </button>
  </nav>
</header>

<style>
  .hdr{position:sticky; top:12px; z-index:60; max-width:calc(var(--max) + 2 * var(--gutter)); margin:12px auto 0; padding-inline:calc(var(--gutter) - 14px)}
  .pill{
    display:flex; align-items:center; gap:18px; min-height:56px; padding:6px 6px 6px 22px;
    border-radius:999px; border:1px solid var(--rule);
    background:color-mix(in srgb, var(--surface) 76%, transparent);
    -webkit-backdrop-filter:blur(18px) saturate(1.35); backdrop-filter:blur(18px) saturate(1.35);
    box-shadow:var(--hl), 0 12px 32px -20px rgba(0,0,0,.3);
  }
  .sig{font:600 var(--t-body)/1 var(--f-sans); letter-spacing:-.02em; color:var(--ink); white-space:nowrap; flex-shrink:0}
  .sig:hover{text-decoration:none; color:var(--accent)}
  .st{font-size:var(--t-small); color:var(--ink-2); white-space:nowrap}
  .navlinks{display:flex; align-items:center; gap:2px; margin-left:auto; min-width:0}
  .navlinks a{
    font-size:var(--t-small); font-weight:500; color:var(--ink-2); padding:10px 14px; border-radius:999px; white-space:nowrap;
    transition:color .25s, background-color .25s;
  }
  .navlinks a:hover{color:var(--ink); background:var(--bg-2); text-decoration:none}
  .navlinks a[aria-current="page"]{color:var(--ink); background:var(--bg-2)}
  .themebtn{
    display:grid; place-items:center; width:42px; height:42px; flex:none;
    border:1px solid var(--rule-strong); border-radius:50%; background:transparent; color:var(--ink-2);
    cursor:pointer; transition:color .25s, border-color .25s;
  }
  .themebtn:hover{color:var(--ink); border-color:var(--ink)}

  @media (max-width:900px){ .st{display:none} }
  @media (max-width:640px){
    .hdr{top:8px; margin-top:8px; padding-inline:12px}
    .pill{min-height:52px; gap:8px; padding:5px 5px 5px 16px}
    .navlinks a{padding:10px 10px}
  }

  /* The narrowest phones: three links still fit on one row. */
  @media (max-width:360px){
    .hdr{padding-inline:8px}
    .pill{gap:2px; padding-left:12px}
    .navlinks{gap:0}
    .navlinks a{padding-inline:6px}
  }

  /* Touch targets — last, because the narrow rule above also matches on a phone. */
  @media (pointer:coarse){
    .navlinks a{padding-block:13px}
    .themebtn{width:44px; height:44px}
  }
</style>
