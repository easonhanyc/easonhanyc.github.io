---
const path = Astro.url.pathname;
const is = (p: string) => path === p || (p !== '/' && path.startsWith(p));
const links = [
  ['/work', 'Work'],
  ['/experience', 'Experience'],
  ['/artifacts', 'Artifacts'],
  ['/about', 'About'],
];
---
<nav class="bar" aria-label="Primary">
  <div class="inner">
    <a class="sig" href="/">Eason Han</a>
    <div class="navlinks">
      {links.map(([href, label]) => (
        <a href={href} aria-current={is(href) ? 'page' : undefined}>{label}</a>
      ))}
      <button class="themebtn" id="theme-toggle" type="button" aria-label="Switch colour theme">
        <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true" focusable="false">
          <circle cx="10" cy="10" r="7.25" fill="none" stroke="currentColor" stroke-width="1.4"/>
          <path d="M10 2.75a7.25 7.25 0 0 1 0 14.5z" fill="currentColor"/>
        </svg>
      </button>
    </div>
  </div>
</nav>

<style>
  .bar{
    position:sticky; top:0; z-index:60;
    background:color-mix(in srgb, var(--bg) 86%, transparent);
    backdrop-filter:blur(16px) saturate(1.2); -webkit-backdrop-filter:blur(16px) saturate(1.2);
    border-bottom:1px solid var(--rule);
  }
  .inner{
    max-width:var(--max); margin-inline:auto; padding:0 var(--gutter);
    display:flex; align-items:center; justify-content:space-between; gap:20px; min-height:68px;
  }
  .sig{
    font-family:var(--f-display); font-weight:600; font-size:21px; letter-spacing:-.04em;
    color:var(--ink); white-space:nowrap; flex-shrink:0; line-height:1;
  }
  .sig:hover{text-decoration:none; color:var(--accent)}
  .navlinks{display:flex; align-items:center; gap:clamp(4px,1.6vw,26px)}
  .navlinks a{
    position:relative; font-size:15px; font-weight:500; color:var(--ink-2); padding:10px 2px;
    transition:color .25s;
  }
  .navlinks a:hover{color:var(--ink); text-decoration:none}
  .navlinks a[aria-current="page"]{color:var(--ink)}
  /* the current page carries a short green rule under it */
  .navlinks a::after{
    content:""; position:absolute; left:2px; right:2px; bottom:4px; height:1px; background:var(--accent);
    transform:scaleX(0); transform-origin:0 50%; transition:transform .45s var(--ease);
  }
  .navlinks a:hover::after,.navlinks a[aria-current="page"]::after{transform:scaleX(1)}
  .themebtn{
    display:grid; place-items:center; width:40px; height:40px; margin-left:4px;
    border:1px solid var(--rule-strong); border-radius:50%; background:none; color:var(--ink-2);
    cursor:pointer; transition:color .25s, border-color .25s, transform .6s var(--ease);
  }
  .themebtn:hover{color:var(--ink); border-color:var(--ink); transform:rotate(180deg)}

  @media (max-width:640px){
    .inner{min-height:58px; gap:12px}
    .sig{font-size:20px}
    /* One row at any width: the links scroll rather than wrapping under the
       name, where a sticky translucent bar would sit over the content. */
    .navlinks{gap:14px; flex-wrap:nowrap; overflow-x:auto; scrollbar-width:none; -ms-overflow-style:none;
      -webkit-mask-image:linear-gradient(90deg,#000 calc(100% - 18px),transparent);
              mask-image:linear-gradient(90deg,#000 calc(100% - 18px),transparent)}
    .navlinks::-webkit-scrollbar{display:none}
    .navlinks a,.themebtn{flex:0 0 auto}
    .navlinks a{font-size:14px}
    .themebtn{width:34px; height:34px; margin-right:14px}
  }

  /* Touch targets — last, because the narrow rule above also matches on a phone.
     Equal specificity, so source order decides. Scoped here because Astro's
     scoped styles outrank global.css. */
  @media (pointer:coarse){
    .navlinks a{padding-block:14px}
    .themebtn{width:42px; height:42px}
  }
</style>
