---
const path = Astro.url.pathname;
const is = (p: string) => path === p || (p !== '/' && path.startsWith(p));
---
<nav class="bar">
  <a class="sig" href="/">Eason Han</a>
  <div class="navlinks">
    <a href="/work" aria-current={is('/work') ? 'page' : undefined}>Work</a>
    <a href="/experience" aria-current={is('/experience') ? 'page' : undefined}>Experience</a>
    <a href="/artifacts" aria-current={is('/artifacts') ? 'page' : undefined}>Artifacts</a>
    <a href="/about" aria-current={is('/about') ? 'page' : undefined}>About</a>
    <button class="themebtn" id="theme-toggle" type="button" aria-label="Switch colour theme">Theme</button>
  </div>
</nav>

<style>
  .bar{
    position:sticky; top:0; z-index:60;
    display:flex; align-items:center; justify-content:space-between; gap:16px;
    padding:14px 24px; background:color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter:blur(14px); -webkit-backdrop-filter:blur(14px);
    border-bottom:1px solid var(--border);
  }
  .sig{font-weight:600; letter-spacing:-.02em; font-size:15px; color:var(--ink); white-space:nowrap; flex-shrink:0}
  .sig:hover{text-decoration:none; color:var(--accent)}
  .navlinks{display:flex; align-items:center; gap:6px; flex-wrap:wrap}
  .navlinks a,.themebtn{
    font-family:var(--mono); font-size:11px; letter-spacing:.07em; text-transform:uppercase;
    color:var(--ink-3); padding:6px 10px; border-radius:7px; border:1px solid transparent;
    background:none; cursor:pointer; font-weight:500;
  }
  .navlinks a:hover,.themebtn:hover{color:var(--ink); border-color:var(--border-strong); text-decoration:none}
  .navlinks a[aria-current="page"]{color:var(--ink); border-color:var(--border-strong)}
  @media (max-width:560px){
    .bar{padding:11px 16px; gap:10px}
    /* One row at any width: the links scroll rather than wrapping under the
       logo, where a sticky translucent bar would sit over the content. */
    .navlinks{gap:2px; flex-wrap:nowrap; overflow-x:auto; scrollbar-width:none; -ms-overflow-style:none}
    .navlinks::-webkit-scrollbar{display:none}
    .navlinks a,.themebtn{flex:0 0 auto}
    .navlinks a,.themebtn{padding:6px 5px; font-size:9.5px; letter-spacing:.03em}
    /* Fits without scrolling on a typical phone; below that the row scrolls and
       the fade says so, rather than leaving a word chopped in half. */
    .navlinks{-webkit-mask-image:linear-gradient(90deg,#000 calc(100% - 20px),transparent);
                      mask-image:linear-gradient(90deg,#000 calc(100% - 20px),transparent)}
  }

  /* Touch targets — last, because the narrow-width rule above also matches on a
     phone and sets `padding` as a shorthand. Same specificity, so source order
     decides. Lives here rather than global.css since Astro scopes these. */
  @media (pointer:coarse){
    .navlinks a,.themebtn{padding-block:15px}
    .sig{padding-block:10px}
  }
</style>
