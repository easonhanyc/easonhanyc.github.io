---
// One row of the work index: position, the project and its one-line summary,
// where and when, then the single result it is best known for.
import type { CollectionEntry } from 'astro:content';
interface Props { project: CollectionEntry<'projects'>; pos: number; reveal?: boolean }
const { project, pos, reveal = true } = Astro.props;
const d = project.data;
const m = d.metrics[0];
---
<article class:list={['proj', reveal && 'rv']} data-tags={d.tags.join(' ')}>
  <span class="pos">{String(pos).padStart(2, '0')}</span>
  <div class="main">
    <h3><a href={`/work/${project.id}`}>{d.title}</a></h3>
    <p class="d">{d.summary}</p>
    {(d.live || d.depth === 'case-study' || d.badges.length > 0) && (
      <div class="tags">
        {d.live && <span class="tag live">Live</span>}
        {d.depth === 'case-study' && <span class="tag deep">Case study</span>}
        {d.badges.map((b) => <span class="tag">{b}</span>)}
      </div>
    )}
  </div>
  <span class="ctx">{d.org ?? 'Independent'}<br />{d.period}</span>
  <span class="res">{m ? <><b>{m.n}</b> {m.l}</> : ''}</span>
  <span class="go" aria-hidden="true">→</span>
</article>
