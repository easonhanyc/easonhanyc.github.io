---
import type { CollectionEntry } from 'astro:content';
import ProjectCard from './ProjectCard.astro';
interface Props { projects: CollectionEntry<'projects'>[] }
const { projects } = Astro.props;

const FILTERS = [
  { f: 'all', label: 'All' },
  { f: 'product', label: 'Product' },
  { f: 'ai', label: 'AI / ML' },
  { f: 'eng', label: 'Engineering' },
  { f: 'shipped', label: 'Shipped & live' },
];
---
<div class="filters" role="group" aria-label="Filter projects by discipline">
  {FILTERS.map((x, i) => (
    <button class="fbtn" type="button" data-f={x.f} aria-pressed={i === 0 ? 'true' : 'false'}>{x.label}</button>
  ))}
</div>

<!-- A timing sheet rather than a card grid: every project on one ranked list,
     read across in a single line each. Positions follow the curated order. -->
<div class="sheet" data-sheet>
  <div class="sheet-head" aria-hidden="true">
    <span>No.</span><span>Project</span><span>Where · when</span><span>Result</span><span></span>
  </div>
  {projects.map((p, i) => <ProjectCard project={p} pos={i + 1} />)}
</div>
<p class="empty" data-empty hidden>No projects match that filter.</p>

<script>
  const btns = Array.from(document.querySelectorAll<HTMLButtonElement>('.fbtn'));
  const rows = Array.from(document.querySelectorAll<HTMLElement>('[data-sheet] .proj'));
  const empty = document.querySelector<HTMLElement>('[data-empty]');

  for (const b of btns) {
    b.addEventListener('click', () => {
      const f = b.dataset.f!;
      btns.forEach((o) => o.setAttribute('aria-pressed', String(o === b)));
      let shown = 0;
      for (const r of rows) {
        const ok = f === 'all' || ` ${r.dataset.tags} `.includes(` ${f} `);
        r.hidden = !ok;
        if (ok) shown++;
      }
      if (empty) empty.hidden = shown !== 0;
    });
  }
</script>
