---
import { contact, visitorLog } from '../lib/site';
const year = new Date().getFullYear();
const ext = { target: '_blank', rel: 'noopener noreferrer' };
---
<!-- The one contact block, on every page. -->
<footer class="foot wrap">
  <div class="in">
    <p class="lbl">Get in touch</p>
    <a class="mail" href={`mailto:${contact.email}`} data-log="email-click">{contact.email}</a>
    <div class="row">
      <p class="who"><strong>Yichen (Eason) Han</strong> · Berkeley, CA · Seeking a Summer 2027 PM internship</p>
      <p class="links">
        <a class="ulink" href={contact.linkedin} {...ext} aria-label="LinkedIn (opens in a new tab)">LinkedIn ↗</a>
        <a class="ulink" href={contact.github} {...ext} aria-label="GitHub (opens in a new tab)">GitHub ↗</a>
      </p>
    </div>
    <p class="fine">© {year} Yichen Han · Set in Newsreader and Geist · Built with Astro{visitorLog.goatcounter.trim() && ' · Visits are counted without cookies'}</p>
  </div>
</footer>

<style>
  .foot{margin-top:clamp(64px,9vw,128px); padding-bottom:32px}
  .in{border-top:1px solid var(--rule-strong); padding-top:clamp(28px,4vw,48px)}
  .mail{
    display:inline-block; margin-top:14px; font:400 var(--t-heading)/1.1 var(--f-serif); letter-spacing:-.02em;
    color:var(--ink); overflow-wrap:anywhere; transition:color .3s;
  }
  .mail:hover{text-decoration:none; color:var(--accent)}
  @media (max-width:460px){ .mail{font-size:var(--t-sub)} }
  .row{display:flex; flex-wrap:wrap; justify-content:space-between; align-items:baseline; gap:10px 40px; margin-top:clamp(28px,4vw,48px)}
  .who{margin:0; font-size:var(--t-small); color:var(--ink-2)}
  .who strong{color:var(--ink); font-weight:600}
  .links{display:flex; gap:0 28px; margin:0; font-size:var(--t-small)}
  /* Touch target: the address is one line of type, so pad it rather than enlarge it. */
  @media (pointer:coarse){ .mail{padding-block:12px; margin-top:2px} }
  .fine{margin:28px 0 0; font-size:var(--t-small); color:var(--ink-3); line-height:1.6}
</style>
