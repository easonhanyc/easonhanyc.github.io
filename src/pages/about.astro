---
import BaseLayout from '../layouts/BaseLayout.astro';

const skills = [
  { k: 'Product', v: 'MVP definition · PRD writing · product strategy · roadmapping · backlog prioritization · user research · metric design' },
  { k: 'Technical', v: 'Claude Code · SQL · Python · R · Excel · Tableau · Salesforce · Figma' },
  { k: 'Also shipped with', v: 'TypeScript · Next.js · Astro · Postgres · Cloudflare Workers/D1 · QuickSight' },
  { k: 'Certified', v: 'AWS AI Practitioner · AWS Data Engineer Associate · Tableau Certified Data Analyst' },
  { k: 'Outside work', v: 'Formula 1 — home simulation and analytics projects · consumer tech · soccer' },
];

const principles = [
  { t: 'Non-goals are the product decision.', d: 'Five things TripMatch would never do were written down before any code was. Every one of them was a cut, and the list is the reason the scope held rather than drifting.' },
  { t: 'Distribution is a technical constraint, not just a growth decision.', d: "A link tapped inside WhatsApp opens in that app's embedded browser, where Google's popup sign-in has nowhere to hand a credential back to. The channel the product depended on to reach every single user was also the one place its sign-in could not work, and desktop testing could never have surfaced that." },
  { t: 'The metric everyone quotes is usually the wrong one.', d: "The Pac-Man agent's +84% reads well until you notice the baseline was not random — it repeated a single move 95.4% of the time. The asteroid model that scored highest on accuracy missed nearly a quarter of the hazardous cases. Both write-ups lead with that instead of the headline." },
  { t: 'I write the limitations down.', d: "Several case studies end on what I'd do differently, and the TripMatch PRD keeps its unresolved questions in the open rather than tidying them away. A portfolio of only wins isn't evidence of judgment — it's evidence of editing." },
];
---
<BaseLayout title="About · Eason Han" description="Background, skills and working principles of Yichen (Eason) Han — MBA/MEng at UC Berkeley Haas, former AWS.">
  <div class="narrow sectionpad">
    <p class="eyebrow">About</p>
    <h2 class="rv-w" style="max-width:17ch">The thinking and the building, <span class="em">same person</span>.</h2>
    <p class="sub">
      Two degrees at Berkeley at once — an MBA at Haas and an M.Eng in IEOR. Before that, three
      years inside an $80B sales organisation at AWS, building the internal products it ran on.
      The through-line is that I don't hand the build off: whoever argues for the thing should be
      the one who makes it.
    </p>

    <section style="margin-top:56px">
      <p class="eyebrow">How I work</p>
      <div class="principles">
        {principles.map((p) => (
          <div class="principle">
            <div class="p-t">{p.t}</div>
            <div class="p-d">{p.d}</div>
          </div>
        ))}
      </div>
    </section>

    <section style="margin-top:56px">
      <p class="eyebrow">Background</p>
      <p class="sub" style="margin-bottom:16px">
        Three years at AWS, a summer at TikTok, a summer in venture, and a beach-cleaning robot.
        The full timeline — with the projects each role produced — is its own page.
      </p>
      <div class="chips"><a class="chip solid" href="/experience">The timeline →</a></div>
    </section>

    <section style="margin-top:56px">
      <p class="eyebrow">Skills</p>
      <div class="xp">
        {skills.map((s) => (
          <div class="row">
            <div><div class="org">{s.k}</div><div class="title">{s.v}</div></div>
          </div>
        ))}
      </div>
    </section>

    <section style="margin-top:56px">
      <p class="eyebrow">Reach me</p>
      <div class="chips">
        <a class="chip solid" href="mailto:eason_han@berkeley.edu">eason_han@berkeley.edu</a>
        <a class="chip" href="https://www.linkedin.com/in/yichen-eason-han/" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn (opens in a new tab)">LinkedIn ↗</a>
        <a class="chip" href="https://github.com/easonhanyc" target="_blank" rel="noopener noreferrer" aria-label="GitHub (opens in a new tab)">GitHub ↗</a>
      </div>
      <p class="sub" style="margin-top:22px; font-size:15px">
        Open to Summer 2027 PM internships — consumer, AI/GenAI, and enterprise/data products.
      </p>
    </section>
  </div>
</BaseLayout>

<style>
  .principles{display:flex; flex-direction:column; gap:22px}
  .principle{border-left:2px solid var(--gold); padding-left:18px}
  .p-t{font-weight:620; color:var(--ink); margin-bottom:5px; font-size:16px}
  .p-d{font-family:var(--prose); font-size:15.5px; color:var(--ink-2); line-height:1.65}
  .xp{display:flex; flex-direction:column}
  .row{display:grid; grid-template-columns:1fr auto; gap:8px 20px; padding:16px 0; border-bottom:1px solid var(--border); align-items:baseline}
  .row:last-child{border-bottom:0}
  .org{font-weight:610; color:var(--ink); font-size:15.5px}
  .title{font-size:14.5px; color:var(--ink-2); margin-top:3px; line-height:1.55}
  .when{font-family:var(--mono); font-size:12px; color:var(--ink-3); white-space:nowrap; text-align:right}
  @media (max-width:560px){ .row{grid-template-columns:1fr} .when{text-align:left} }
</style>
