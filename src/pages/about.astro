---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const entries = (await getCollection('experience')).sort((a, b) => a.data.order - b.data.order);
const projects = await getCollection('projects');
const titleOf = (id: string) => (projects.find((p) => p.id === id)?.data.title ?? id).split(' — ')[0];

const principles = [
  { t: 'What you decide not to build is the product decision.', d: 'Five things TripMatch would never do were written down before any code was. Every one of them was a cut, and the list is the reason the scope held rather than drifting.' },
  { t: 'Distribution is a technical constraint, not just a growth decision.', d: "A link tapped inside WhatsApp opens in that app's embedded browser, where Google's popup sign-in has nowhere to hand a credential back to. The channel the product depended on to reach every single user was also the one place its sign-in could not work, and desktop testing could never have surfaced that." },
  { t: 'The metric everyone quotes is usually the wrong one.', d: "The Pac-Man agent's +84% reads well until you notice the baseline was not random — it repeated a single move 95.4% of the time. The asteroid model that scored highest on accuracy missed nearly a quarter of the hazardous cases. Both write-ups lead with that instead of the headline." },
  { t: 'I write the limitations down.', d: "The TripMatch PRD keeps its unresolved questions in the open rather than tidying them away. A portfolio of only wins isn't evidence of judgment — it's evidence of editing." },
];

const skills = [
  { k: 'Product', v: 'MVP definition · PRD writing · product strategy · roadmapping · backlog prioritization · user research · metric design' },
  { k: 'Technical', v: 'Claude Code · SQL · Python · R · Excel · Tableau · Salesforce · Figma' },
  { k: 'Also shipped with', v: 'TypeScript · Next.js · Astro · Postgres · Cloudflare Workers/D1 · QuickSight' },
  { k: 'Certified', v: 'AWS AI Practitioner · AWS Data Engineer Associate · Tableau Certified Data Analyst' },
  { k: 'Outside work', v: 'Formula 1 — home simulation and analytics projects · consumer tech · soccer' },
];
---
<BaseLayout title="About · Eason Han" description="Background, experience, skills and working principles of Yichen (Eason) Han — MBA/MEng at UC Berkeley Haas, former AWS.">
  <div class="wrap">
    <header class="pagehead">
      <p class="eyebrow rv">About</p>
      <h1 class="rv">The thinking and the building, <span class="em">same person.</span></h1>
      <p class="lede rv">
        Two degrees at Berkeley at once — an MBA at Haas and an M.Eng in IEOR. Before that, three
        years inside an $80B sales organisation at AWS, building the internal products it ran on.
        The through-line is that I don't hand the build off: whoever argues for the thing should be
        the one who makes it.
      </p>
    </header>

    <!-- Each section is a row: its name on a narrow rail, the content beside it. -->
    <section class="band" aria-labelledby="how-h">
      <h2 id="how-h">How I work</h2>
      <ol class="principles">
        {principles.map((p) => (
          <li class="rv"><h3>{p.t}</h3><p>{p.d}</p></li>
        ))}
      </ol>
    </section>

    <section class="band" id="experience" aria-labelledby="exp-h">
      <div>
        <h2 id="exp-h">Experience</h2>
        <ul class="legend" aria-label="Line key">
          <li class="k-work">Work</li><li class="k-education">Study</li><li class="k-volunteer">Volunteer</li>
        </ul>
      </div>
      <!-- A transit line rather than a bullet list: each role is a stop, and the
           line changes colour with what kind of stop it is. -->
      <ol class="line">
        {entries.map((e) => (
          <li class:list={['stop', 'rv', `is-${e.data.kind}`]}>
            <span class="node" aria-hidden="true"></span>
            <div class="body">
              <p class="lbl">{e.data.start} — {e.data.end}</p>
              <h3>{e.data.org}</h3>
              <p class="role">{e.data.role}{e.data.location && <span class="loc"> · {e.data.location}</span>}</p>
              <p class="sum">{e.data.summary}</p>
              {e.data.outcomes.length > 0 && (
                <ul class="out">
                  {e.data.outcomes.map((o) => <li>{o}</li>)}
                </ul>
              )}
              {e.data.related.length > 0 && (
                <p class="rel">
                  {e.data.related.map((id) => (
                    <a class="ulink" href={`/work/${id}`}>{titleOf(id)}</a>
                  ))}
                </p>
              )}
            </div>
          </li>
        ))}
      </ol>
    </section>

    <section class="band" aria-labelledby="skills-h">
      <h2 id="skills-h">Skills</h2>
      <dl class="skills">
        {skills.map((s) => (
          <div class="rv"><dt>{s.k}</dt><dd>{s.v}</dd></div>
        ))}
      </dl>
    </section>

    <section class="band" aria-labelledby="off-h">
      <h2 id="off-h">Off the clock</h2>
      <div class="rv">
        <p class="off"><strong>Formula 1.</strong> I scraped 32 seasons of results to work out car speed, which F1 doesn't publish.</p>
        <a class="go" href="/work/formula-1-trends">The analysis <i>→</i></a>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .pagehead .lede{max-width:54ch}

  .band{display:grid; gap:20px; padding-top:18px; border-top:1px solid var(--rule-strong)}
  .band + .band{margin-top:clamp(48px,6vw,88px)}
  .band h2{font:600 var(--t-sub)/1.2 var(--f-sans); letter-spacing:-.02em; margin:0}
  @media (min-width:900px){
    .band{grid-template-columns:minmax(0,3fr) minmax(0,9fr); column-gap:var(--gap)}
  }

  .principles{list-style:none; margin:0; padding:0; display:grid; gap:clamp(28px,3vw,40px) var(--gap)}
  @media (min-width:800px){ .principles{grid-template-columns:repeat(2,minmax(0,1fr))} }
  .principles h3{margin:0 0 10px}
  .principles p{line-height:1.65; color:var(--ink-2); margin:0}

  .legend{display:flex; flex-wrap:wrap; gap:6px 18px; list-style:none; margin:14px 0 0; padding:0; font-size:var(--t-small); color:var(--ink-3)}
  .legend li{display:flex; align-items:center; gap:8px}
  .legend li::before{content:""; width:22px; height:0; border-top:3px solid var(--ink)}
  .legend .k-education::before{border-top-color:var(--accent)}
  .legend .k-volunteer::before{border-top-style:dotted; border-top-color:var(--ink-3)}

  .line{list-style:none; margin:0; padding:0; --node:15px}
  .stop{
    position:relative; display:grid; grid-template-columns:var(--node) minmax(0,1fr); column-gap:22px;
    padding-bottom:clamp(32px,4vw,48px); --c:var(--ink); --ls:solid;
  }
  .stop:last-child{padding-bottom:0}
  .stop.is-education{--c:var(--accent)}
  .stop.is-volunteer{--c:var(--ink-3); --ls:dotted}
  /* the line itself, from this stop's node down to the next */
  .stop::before{
    content:""; position:absolute; left:calc(var(--node) / 2 - 1.5px); top:calc(var(--node) / 2 + 2px); bottom:-2px;
    border-left:3px var(--ls) var(--c);
  }
  .stop:last-child::before{display:none}
  .node{width:var(--node); height:var(--node); margin-top:2px; border-radius:50%; background:var(--bg); border:3px solid var(--c); position:relative; z-index:1}
  .body{max-width:760px}
  .body h3{margin:6px 0 0}
  .role{font-size:var(--t-small); color:var(--ink); margin:6px 0 0; font-weight:600}
  .loc{color:var(--ink-3); font-weight:400}
  .sum{line-height:1.65; color:var(--ink-2); margin:12px 0 0}
  .out{margin:12px 0 0; padding-left:18px}
  .out li{line-height:1.6; color:var(--ink-2); margin-bottom:6px}
  .out li::marker{color:var(--ink-3)}
  .rel{display:flex; flex-wrap:wrap; gap:8px 22px; margin:16px 0 0; font-size:var(--t-small)}

  .skills{margin:0}
  .skills > div{display:grid; gap:4px 24px; padding:14px 0; border-bottom:1px solid var(--rule)}
  .skills > div:first-child{padding-top:0}
  @media (min-width:700px){ .skills > div{grid-template-columns:180px minmax(0,1fr)} }
  .skills dt{font-size:var(--t-small); font-weight:600; color:var(--ink); padding-top:2px}
  .skills dd{margin:0; line-height:1.55; color:var(--ink-2)}

  .off{margin:0 0 10px; max-width:52ch; color:var(--ink-2)}
  .off strong{color:var(--ink); font-weight:600}
</style>
