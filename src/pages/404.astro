    <header class="pagehead">
      <p class="eyebrow">404 · Not found</p>
      <h1>That page <span class="em">doesn't exist.</span></h1>
      <p class="lede">It may have moved when this site was rebuilt. These do exist:</p>
    </header>
    <div class="chips">
      <a class="chip solid" href="/">Home</a>
      <a class="chip" href="/work">Work</a>
      <a class="chip" href="/artifacts">Artifacts</a>
      <a class="chip" href="/about">About</a>
    </div>
  </div>
</BaseLayout>
