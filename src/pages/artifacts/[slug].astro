---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const artifacts = await getCollection('artifacts');
  return artifacts.map((artifact) => ({ params: { slug: artifact.id }, props: { artifact } }));
}

const { artifact } = Astro.props;
const d = artifact.data;
const { Content } = await render(artifact);

const projects = await getCollection('projects');
const parent = d.related ? projects.find((p) => p.id === d.related) : undefined;
---
<BaseLayout title={`${d.title} · Eason Han`} description={d.description}>
  <div class="narrow">
    <div class="backbar"><a href="/artifacts">← All artifacts</a></div>
    <header class="dochead">
      <p class="eyebrow">{d.kind}</p>
      <h1 class="rv-w" style="font-size:clamp(30px,5vw,50px)">{d.title}</h1>
      {parent && (
        <p class="docmeta">
          <span>From <a href={`/work/${parent.id}`}>{parent.data.title}</a></span>
        </p>
      )}
    </header>
    <article class="prose" style="margin-top:34px"><Content /></article>
    <div style="padding:56px 0 20px">
      <a class="chip" href="/artifacts">← All artifacts</a>
      {parent && <a class="chip" href={`/work/${parent.id}`}>{parent.data.title} case study →</a>}
    </div>
  </div>
</BaseLayout>
