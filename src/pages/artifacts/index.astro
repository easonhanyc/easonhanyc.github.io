---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const artifacts = (await getCollection('artifacts')).sort((a, b) => a.data.order - b.data.order);
---
<BaseLayout title="Artifacts · Eason Han" description="Working product documents: a full PRD, a pre-launch architecture review, a prioritization framework, and a metric tree.">
  <div class="wrap">
    <header class="pagehead">
      <p class="eyebrow rv">{artifacts.length} documents</p>
      <h1 class="rv">The working documents, not just <span class="em">the summaries.</span></h1>
      <p class="lede rv">So the reasoning can be read and checked, not just taken on trust.</p>
    </header>
    <ul class="rows">
      {artifacts.map((a) => (
        <li class="rv"><a href={`/artifacts/${a.id}`}>
          <span class="lbl">{a.data.kind}</span>
          <span><span class="t">{a.data.title}</span><span class="d">{a.data.description}</span></span>
          <span class="arrow" aria-hidden="true">→</span>
        </a></li>
      ))}
    </ul>
  </div>
</BaseLayout>
