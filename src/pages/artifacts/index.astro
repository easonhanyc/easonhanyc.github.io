---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const artifacts = (await getCollection('artifacts')).sort((a, b) => a.data.order - b.data.order);
---
<BaseLayout title="Artifacts · Eason Han" description="Working product documents: a full PRD, a pre-launch architecture review, a prioritization framework, and a metric tree.">
  <div class="wrap sectionpad">
    <div class="chap rv"><span class="no">{String(artifacts.length).padStart(2, '0')}</span><span class="ln"></span><span class="lb">Documents</span></div>
    <div class="head">
      <h2 class="rv-w">The working documents, <span class="em">not just the summaries</span>.</h2>
      <p class="sub rv">So the reasoning is inspectable rather than asserted.</p>
    </div>
    <div class="arts">
      {artifacts.map((a) => (
        <a class="tile art rv" href={`/artifacts/${a.id}`}>
          <span class="k">{a.data.kind}</span>
          <span class="t">{a.data.title}</span>
          <span class="d">{a.data.description}</span>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .head{display:grid; gap:0; margin-bottom:clamp(36px,4vw,64px)}
  .head h2{max-width:14ch}
  @media (min-width:1000px){
    .head{grid-template-columns:minmax(0,7fr) minmax(0,5fr); column-gap:var(--gap); align-items:end}
    .head .sub{margin-bottom:34px}
  }
</style>
