---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { contact } from '../lib/site';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
// Six blocks on this page; the Work page has all of them.
const more = projects.filter((p) => !p.data.featured).slice(0, 6);
const ext = { target: '_blank', rel: 'noopener noreferrer' };

// Sample rides for the working copy of the board. Illustrative only: they show
// how the board behaves, not who is using it.
const rides = [
  { name: 'SFO airport', when: 'Fri 4:00pm', n: 3, cap: 4 },
  { name: 'Tahoe trek', when: 'Sat 8:00am', n: 1, cap: 3 },
  { name: 'Napa, Sunday', when: 'Sun 9:30am', n: 4, cap: 4 },
];
---
<BaseLayout
  title="Eason Han"
  description="Product portfolio of Yichen (Eason) Han — MBA/MEng at UC Berkeley Haas, former AWS. 0-to-1 products, PRDs, and shipped code."
>
  <!-- One idea per screen, read top to bottom: who I am, TripMatch, Action Hub,
       more projects, background. The footer carries the contact block. -->

  <!-- 1. Opening -->
  <section class="hero wrap" aria-labelledby="hero-name">
    <div class="hero-top rv">
      <h1 class="hero-name" id="hero-name">Eason Han <span>· Product manager</span></h1>
      <p class="hero-seek"><span class="dot"></span>Seeking a Summer 2027 PM internship</p>
    </div>
    <p class="display hero-pitch rv">I build the products <span class="em">I pitch.</span></p>
    <p class="hero-bio rv"><span class="nw">MBA / M.Eng</span> candidate at <strong>UC Berkeley Haas &amp; IEOR</strong>, after three years at <strong>AWS</strong> building analytics products for an $80B sales org.</p>
    <p class="hero-links rv">
      <a class="ulink" href={contact.linkedin} {...ext} aria-label="LinkedIn (opens in a new tab)">LinkedIn ↗</a>
      <a class="ulink" href={contact.github} {...ext} aria-label="GitHub (opens in a new tab)">GitHub ↗</a>
      <a class="ulink" href={`mailto:${contact.email}`} data-log="email-click">{contact.email}</a>
    </p>
  </section>

  <!-- 2 and 3. The two featured projects, built from one template -->
  <section class="sec wrap" id="featured" aria-labelledby="featured-h">
    <header class="sec-h rv">
      <h2 id="featured-h">Featured projects</h2>
    </header>

    <article class="feat rv" aria-labelledby="tm-h">
      <div class="feat-copy">
        <p class="lbl">01 · Live since Aug 2026</p>
        <h3 class="feat-t" id="tm-h">TripMatch</h3>
        <p class="feat-role">Sole PM, designer and engineer</p>
        <p class="feat-d">A rides board for my Berkeley Haas class: post a trip, and whoever needs the seat taps once and it's theirs.</p>
        <dl class="feat-figs">
          <div><dt>No app</dt><dd>opens from the group chat</dd></div>
          <div><dt>Verified</dt><dd>Berkeley classmates only</dd></div>
        </dl>
        <a class="go" href="/work/tripmatch" data-log="case-study-tripmatch">Read the case study <i>→</i></a>
      </div>
      <div class="tile feat-vis">
        <p class="vis-h"><span>Sample rides</span><span class="try">Try it: tap +1</span></p>
        <div class="board" data-board>
          <ul aria-label="Sample rides">
            {rides.map((r) => (
              <li data-n={r.n} data-cap={r.cap}>
                <span><b>{r.name}</b><span class="when">{r.when}</span></span>
                <span class="s">{r.n} of {r.cap}</span>
                <button type="button" aria-pressed="false" aria-label={`Take a seat on ${r.name}`} data-log="rides-board-tap">+1</button>
              </li>
            ))}
          </ul>
          <p class="toast" aria-live="polite">A working copy of the board, with sample rides.</p>
        </div>
      </div>
    </article>

    <article class="feat rv" aria-labelledby="ah-h">
      <div class="feat-copy">
        <p class="lbl">02 · AWS, 2023–2026</p>
        <h3 class="feat-t" id="ah-h">Action Hub</h3>
        <p class="feat-role">Product owner</p>
        <p class="feat-d">The screen an AWS seller opens first each morning: it ranks what needs attention across their accounts and writes the next step on each line.</p>
        <dl class="feat-figs">
          <div><dt>70%</dt><dd>less time for sellers to find account insights</dd></div>
          <div><dt>10,000+</dt><dd>sellers served</dd></div>
        </dl>
        <a class="go" href="/work/action-hub" data-log="case-study-action-hub">Read the case study <i>→</i></a>
      </div>
      <div class="tile feat-vis" aria-hidden="true">
        <p class="vis-h"><span>Today's list, most urgent first</span></p>
        <ol class="ranked">
          <li><i style="background:var(--red)"></i><span><b>Renewal risk · 3 accounts</b><span>Next: schedule exec review this week</span></span><em>1</em></li>
          <li><i style="background:var(--gold)"></i><span><b>Idle capacity · 7 accounts</b><span>Next: propose rightsizing plan</span></span><em>2</em></li>
          <li><i style="background:var(--accent)"></i><span><b>Support backlog · 2 accounts</b><span>Next: escalate to TAM</span></span><em>3</em></li>
        </ol>
        <p class="ranked-note">An illustration of the list, not real account data.</p>
      </div>
    </article>
  </section>

  <!-- 4. More projects: six blocks, each with its own small drawing -->
  <section class="sec wrap" id="more" aria-labelledby="more-h">
    <header class="sec-h rv">
      <h2 id="more-h">More projects</h2>
      <a class="go" href="/work">All {projects.length} projects <i>→</i></a>
    </header>
    <div class="cat home-cat">
      {more.map((p) => <ProjectCard project={p} />)}
    </div>
  </section>

  <!-- 5. Background: the route so far -->
  <section class="sec wrap" id="background" aria-labelledby="background-h">
    <header class="sec-h rv">
      <h2 id="background-h">Background</h2>
      <a class="go" href="/about">More about me <i>→</i></a>
    </header>
    <ol class="route rv">
      <li class="edu"><span class="y">2019</span><b>Notre Dame</b><span class="r">Business analytics &amp; math</span></li>
      <li><span class="y">2020</span><b>IDG Capital</b><span class="r">Venture intern</span></li>
      <li><span class="y">2021</span><b>TikTok</b><span class="r">Ads integrity intern</span></li>
      <li><span class="y">2023</span><b>AWS</b><span class="r">Three years, sales analytics</span></li>
      <li class="edu"><span class="y">2026</span><b>Berkeley Haas</b><span class="r">MBA / M.Eng</span></li>
    </ol>
  </section>
</BaseLayout>

<style>
  /* Three across on a laptop, so the six blocks make two even rows. */
  @media (min-width:960px){ .home-cat{grid-template-columns:repeat(3,minmax(0,1fr))} }
</style>

<script>
  // ── the working rides board: the one interactive moment on the page ──
  const board = document.querySelector<HTMLElement>('[data-board]');
  if (board) {
    const toast = board.querySelector<HTMLElement>('.toast');
    if (toast) toast.innerHTML = 'Tap <b>+1</b> on any ride to take a seat.';
    for (const li of board.querySelectorAll<HTMLElement>('li')) {
      const btn = li.querySelector('button')!;
      if (+li.dataset.n! >= +li.dataset.cap!) { btn.disabled = true; btn.textContent = 'Full'; btn.setAttribute('aria-label', `${li.querySelector('b')!.textContent} is full`); }
    }
    board.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest('button');
      if (!btn || btn.disabled) return;
      const li = btn.closest('li')!;
      const cap = +li.dataset.cap!;
      const joined = li.classList.toggle('in');
      const n = +li.dataset.n! + (joined ? 1 : -1);
      li.dataset.n = String(n);
      const s = li.querySelector<HTMLElement>('.s')!;
      s.textContent = `${n} of ${cap}`;
      s.classList.remove('pop'); void s.offsetWidth; s.classList.add('pop');
      btn.textContent = joined ? 'You’re in' : '+1';
      btn.setAttribute('aria-pressed', String(joined));
      const name = li.querySelector('b')!.textContent;
      if (toast) toast.innerHTML = joined
        ? `<b>Seat taken on ${name}.</b> Everyone looking at the board now sees ${n} of ${cap}.`
        : `Seat given back on ${name}.`;
    });
  }
</script>
