---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PinnedStory from '../components/PinnedStory.astro';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const aws = projects.find((p) => p.id === 'action-hub')!;
const rest = projects.filter((p) => !p.data.featured);

// Editorial narrative for the one cinematic moment — hand-written, not derived
// from card metrics, because the story is the point rather than the figures.
const tripmatchSteps = [
  { n: '6',   u: 'Days — PRD to public launch',
    d: 'Sole PM, designer and engineer, start to finish — specification, design, implementation, launch.' },
  { n: '34',  u: 'Commits — 168 automated checks',
    d: '168 automated checks, which is what made rebuilding the storage layer the day before launch a decision rather than a gamble.' },
  { n: '3',   u: 'Defects — found in my own v1',
    d: "The day before launch, a race condition let two simultaneous posts silently delete each other. You post, you see it appear, on refresh it's gone — so you post again, which makes the race more likely. I rebuilt the storage layer rather than ship it." },
  { n: '400', u: 'Cohort served — live today',
    d: 'Three feedback-driven iterations after launch: owner-scoped delete, in-place edit that preserves comment threads, and date chips that only appear once the board spans more than one date.' },
];

---
<BaseLayout
  title="Eason Han"
  description="Product portfolio of Yichen (Eason) Han — MBA/MEng at UC Berkeley Haas, former AWS. 0-to-1 products, PRDs, and shipped code."
>
  <header class="hero wrap">
    <p class="eyebrow">Product Management · Berkeley Haas</p>
    <h1>Product thinking<span class="dim">,</span> and the hands to build it<span class="dim">.</span></h1>
    <p class="lede">
      MBA / MEng candidate at <strong>UC Berkeley Haas &amp; IEOR</strong>.
      Three years at <strong>AWS</strong> building analytics products for an $80B sales org.
    </p>
    <div class="chips">
      <a class="chip solid" href="/work">See the work</a>
      <a class="chip" href="https://www.linkedin.com/in/yichen-eason-han/">LinkedIn ↗</a>
      <a class="chip" href="mailto:eason_han@berkeley.edu">eason_han@berkeley.edu</a>
    </div>
  </header>

  <div class="strip">
    <div class="wrap">
      <div><span class="dot"></span>Seeking <b>Summer 2027 PM internship</b></div>
      <div>Focus <b>AI · Mobility · Consumer · Enterprise</b></div>
      <div>Based <b>Berkeley, CA</b></div>
    </div>
  </div>

  <PinnedStory
    eyebrow="01 — Shipped alone · Aug 2026"
    title="TripMatch"
    sub="Rides for a 400-person cohort, shipped alone in under a week. The constraint that made it possible: five things written down before any code that the product would never do."
    href="/work/tripmatch"
    steps={tripmatchSteps}
  />

  <section class="panel">
    <div class="stage wrap sectionpad">
      <div class="pin-head">
        <p class="eyebrow">02 — 0 → 1 at scale · AWS, 2023–2026</p>
        <h2>Action Hub</h2>
        <p class="sub">
          Two hundred dashboards, and no agreed answer to "where do I start?". I owned the first
          tab a seller lands on — which made the real question not what to show, but what to put
          at the top and what to say about it.
        </p>
        <a class="chip" href="/work/action-hub">Read the case study →</a>
      </div>
      <div class="steps" style="margin-top:38px">
        {aws.data.metrics.map((m) => (
          <article class="step rv">
            <span class="n">{m.n}</span>
            <span class="u">{m.l}</span>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="sectionpad">
    <div class="wrap">
      <p class="eyebrow rv">Everything else</p>
      <h2 class="rv" style="max-width:16ch">The full shelf.</h2>
      <p class="sub rv">{rest.length} more — agentic tooling, forecasting, data governance, go-to-market, full-stack engineering, and reinforcement learning.</p>
      <ul class="shelf rv">
        {rest.map((p) => (
          <li><a href={`/work/${p.id}`}>{p.data.title}</a></li>
        ))}
      </ul>
      <p style="margin-top:28px"><a class="chip" href="/work">All work, filterable →</a></p>
    </div>
  </section>
</BaseLayout>

<style>
  .hero{padding:76px 0 60px}

  /* Title-only index. No summaries or metrics — those live on /work and on the page itself. */
  .shelf{list-style:none; margin:34px 0 0; padding:0; border-top:1px solid var(--border)}
  .shelf li{border-bottom:1px solid var(--border)}
  .shelf a{
    display:flex; align-items:baseline; justify-content:space-between; gap:20px;
    padding:17px 2px; color:var(--ink); text-decoration:none;
    font-family:var(--display); font-size:clamp(19px,2.4vw,25px); letter-spacing:-.02em;
  }
  .shelf a::after{content:"→"; font-family:var(--mono); font-size:14px; color:var(--ink-3)}
  .shelf a:hover{color:var(--accent); text-decoration:none}
  .shelf a:hover::after{color:var(--accent); transform:translateX(4px)}
  @media (prefers-reduced-motion:reduce){ .shelf a:hover::after{transform:none} }
  h1 .dim{color:var(--ink-3)}
  @media (max-width:560px){ .hero{padding:52px 0 44px} }
</style>
