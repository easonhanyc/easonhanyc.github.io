---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const rest = projects.filter((p) => !p.data.featured);
const ext = { target: '_blank', rel: 'noopener noreferrer' };

// Sample rides for the working copy of the board. Illustrative only: they show
// how the board behaves, not who is using it.
const rides = [
  { name: 'SFO airport', when: 'Fri 4:00pm', n: 3, cap: 4 },
  { name: 'Tahoe trek', when: 'Sat 8:00am', n: 1, cap: 3 },
  { name: 'Napa, Sunday', when: 'Sun 9:30am', n: 4, cap: 4 },
  { name: 'San Jose', when: 'Fri 6:15pm', n: 2, cap: 4 },
];

// Three working principles, shortened from /about. All three render, so the
// tile reads in full without JS; the script shows one at a time.
const ideas = [
  { t: 'The metric everyone quotes is usually the wrong one.',
    d: "The Pac-Man agent's +84% reads well until you notice the starting point wasn't random: it repeated a single move 95.4% of the time. The write-up leads with that instead of the headline." },
  { t: 'I write the limitations down.',
    d: "The TripMatch PRD keeps its unresolved questions in the open rather than tidying them away. A portfolio of only wins isn't evidence of judgment." },
  { t: 'Where users are decides what you can build.',
    d: "A link tapped inside WhatsApp opens in WhatsApp's own browser, where Google sign-in can't finish. The channel that reached every user was the one place sign-in broke." },
];
---
<BaseLayout
  title="Eason Han"
  description="Product portfolio of Yichen (Eason) Han — MBA/MEng at UC Berkeley Haas, former AWS. 0-to-1 products, PRDs, and shipped code."
>
  <!-- The person stays pinned on the left; the work scrolls past on the right. -->
  <div class="axc">
    <aside class="side">
      <div class="tile idp rv">
        <div class="idtop">
        <div class="who">
          <span class="mono" aria-hidden="true">E<span>H</span></span>
          <div>
            <h1>Eason Han</h1>
            <p class="role">Product manager · Berkeley Haas</p>
          </div>
        </div>
        <p class="pitch">I build the products <span class="em">I pitch.</span></p>
        <p class="bio">MBA / M.Eng candidate at <strong>UC Berkeley Haas &amp; IEOR</strong>. Three years at <strong>AWS</strong> building analytics products for an $80B sales org.</p>
        </div>
        <dl class="facts">
          <div><dt>Now</dt><dd>First semester, MBA / M.Eng</dd></div>
          <div><dt>Just shipped</dt><dd><a href="/work/job-search-agent">Job Search Agent</a></dd></div>
          <div><dt>Focus</dt><dd>AI · Mobility · Consumer · Enterprise</dd></div>
          <div><dt>Off the clock</dt><dd>Formula 1 · soccer</dd></div>
        </dl>
        <div class="cta">
          <p class="avail"><span class="dot pulse"></span>Open to Summer 2027 PM internships</p>
          <div class="chips">
            <a class="chip solid" href="/work">See the work</a>
            <a class="chip" href="https://www.linkedin.com/in/yichen-eason-han/" {...ext} aria-label="LinkedIn (opens in a new tab)">LinkedIn ↗</a>
            <a class="chip" href="https://github.com/easonhanyc" {...ext} aria-label="GitHub (opens in a new tab)">GitHub ↗</a>
          </div>
          <a class="addr" href="mailto:eason_han@berkeley.edu">eason_han@berkeley.edu</a>
        </div>
      </div>
    </aside>

    <div class="bento">
      <section class="tile pad trip rv" aria-labelledby="tm-h">
        <div class="th"><span class="lbl">0→1 build · Aug 2026</span><span class="lbl"><span class="dot"></span>Live</span></div>
        <h2 id="tm-h">TripMatch</h2>
        <p class="d">A rides board I designed, built and shipped for my Berkeley Haas class. Post a trip; whoever needs the seat taps once and it's theirs. No app to install, and only verified classmates can see it.</p>
        <div class="board" data-board>
          <ul aria-label="Sample rides">
            {rides.map((r) => (
              <li data-n={r.n} data-cap={r.cap}>
                <span><b>{r.name}</b><span class="when">{r.when}</span></span>
                <span class="s">{r.n} of {r.cap}</span>
                <button type="button" aria-pressed="false" aria-label={`Take a seat on ${r.name}`}>+1</button>
              </li>
            ))}
          </ul>
          <p class="toast" aria-live="polite">A working copy of the board, with sample rides.</p>
        </div>
        <ul class="feats" aria-label="What it does">
          <li><b>One board</b>every ride in one place</li>
          <li><b>+1</b>one tap and the seat is yours</li>
          <li><b>No app</b>opens from the group chat</li>
          <li><b>Verified</b>Berkeley classmates only</li>
        </ul>
        <a class="go" href="/work/tripmatch">How I built it <i>→</i></a>
      </section>

      <section class="tile pad nowt rv" aria-label="Local time in Berkeley">
        <div class="th"><span class="lbl">Right now in Berkeley</span><span class="lbl" data-day></span></div>
        <div class="clock" data-clock>Pacific Time</div>
        <p>Two degrees at once: an MBA at Haas and an M.Eng in IEOR.</p>
      </section>

      <section class="tile pad aht rv" aria-labelledby="ah-h">
        <div class="th"><span class="lbl" id="ah-h">Action Hub · AWS 2023–26</span></div>
        <div class="big"><span data-count="70">70</span><sup>%</sup></div>
        <p>less time for sellers to find account insights: one ranked list in place of about 200 dashboards, for <strong>10,000+ sellers</strong>.</p>
        <div class="ranked" aria-hidden="true">
          <div><i style="background:var(--red)"></i><span><b>Renewal risk · 3 accounts</b><span>Next: schedule exec review this week</span></span><em>01</em></div>
          <div><i style="background:var(--gold)"></i><span><b>Idle capacity · 7 accounts</b><span>Next: propose rightsizing plan</span></span><em>02</em></div>
        </div>
        <a class="go" href="/work/action-hub">Read the case study <i>→</i></a>
      </section>

      <section class="tile pad rt rv" aria-label="The route so far">
        <div class="th"><span class="lbl">The route so far</span><a class="go" href="/experience">Experience <i>→</i></a></div>
        <ol class="route">
          <li class="edu"><span class="y">2019</span><b>Notre Dame</b><span class="r">Business analytics &amp; math</span></li>
          <li><span class="y">2020</span><b>IDG Capital</b><span class="r">Venture intern</span></li>
          <li><span class="y">2021</span><b>TikTok</b><span class="r">Ads integrity intern</span></li>
          <li><span class="y">2023</span><b>AWS</b><span class="r">Three years, sales analytics</span></li>
          <li class="edu"><span class="y">2026</span><b>Berkeley Haas</b><span class="r">MBA / M.Eng</span></li>
        </ol>
      </section>

      <section class="tile pad f1t rv" aria-labelledby="f1-h">
        <div class="th"><span class="lbl">Off the clock</span></div>
        <div class="chk" aria-hidden="true"></div>
        <h3 id="f1-h">Formula 1</h3>
        <p class="fig"><b>32</b><span>seasons of results, scraped</span></p>
        <p>to work out car speed, which F1 doesn't publish.</p>
        <a class="go" href="/work/formula-1-trends">The analysis <i>→</i></a>
      </section>

      <section class="tile pad ideat rv" aria-label="How I work" data-ideas>
        {ideas.map((x, i) => (
          <p class:list={['q', i === 0 && 'on']}>{x.t}<span>{x.d}</span></p>
        ))}
        <div class="ctl"><span class="n">1 / {ideas.length}</span><button class="chip" type="button">Next idea →</button><a class="go" href="/about">More on how I work <i>→</i></a></div>
      </section>

      <section class="moreb" aria-labelledby="more-h">
        <div class="mh">
          <h2 id="more-h">More <span class="em">projects</span></h2>
          <a class="go" href="/work">All work <i>→</i></a>
        </div>
        <div class="cat">
          {rest.map((p) => <ProjectCard project={p} />)}
          <a class="tile bk all rv" href="/work">
            <span class="top"><span>Index</span><span>2022–2026</span></span>
            <span class="t">See all {projects.length} projects</span>
            <span class="m"><span>Case studies, builds and coursework</span><span class="arrow" aria-hidden="true">→</span></span>
          </a>
        </div>
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  .axc{max-width:var(--shell); margin:12px auto 0; padding-inline:var(--edge); display:grid; gap:12px}
  @media (min-width:1100px){
    .axc{grid-template-columns:clamp(340px,27vw,400px) minmax(0,1fr); align-items:start}
    .side{position:sticky; top:84px; height:calc(100vh - 96px); height:calc(100dvh - 96px)}
    .side > .idp{height:100%; overflow:auto; scrollbar-width:none}
  }
  /* Between phone and desktop the card sits on top, in two columns. */
  .idtop{display:flex; flex-direction:column; gap:20px}
  @media (min-width:760px) and (max-width:1099px){
    .side > .idp{display:grid; grid-template-columns:minmax(0,1fr) minmax(0,1fr); grid-template-areas:"top facts" "cta cta"; gap:22px 32px; align-items:start}
    .idtop{grid-area:top} .idp :global(.facts){grid-area:facts}
    .idp :global(.cta){grid-area:cta; display:flex; flex-wrap:wrap; align-items:center; gap:12px 20px; padding-top:18px; border-top:1px solid var(--rule)}
  }

  .bento{display:grid; gap:12px; grid-template-columns:minmax(0,1fr); align-content:start}
  @media (min-width:700px){
    .bento{grid-template-columns:repeat(6,minmax(0,1fr))}
    .trip,.rt,.moreb{grid-column:1 / -1}
    .nowt,.aht{grid-column:span 3}
    .f1t{grid-column:span 2}
    .ideat{grid-column:span 4}
  }
  @media (min-width:1360px){
    .trip{grid-column:1 / span 4; grid-row:1 / span 2}
    .nowt{grid-column:5 / span 2; grid-row:1}
    .aht{grid-column:5 / span 2; grid-row:2}
    .rt{grid-column:1 / span 4}
    .f1t{grid-column:5 / span 2}
    .ideat{grid-column:1 / -1}
  }

  .trip .board{margin-top:4px}
  .trip .go{margin-top:auto}
  .feats{list-style:none; margin:4px 0 0; padding:0; display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:1px; background:var(--rule); border:1px solid var(--rule); border-radius:12px; overflow:hidden}
  @media (min-width:700px){ .feats{grid-template-columns:repeat(4,minmax(0,1fr))} }
  .feats li{background:var(--bg-2); padding:12px 14px; font-size:13px; line-height:1.45; color:var(--ink-2)}
  .feats b{display:block; font-size:15px; font-weight:600; color:var(--ink); letter-spacing:-.01em; margin-bottom:2px}
  .ideat .q:not(.on){display:none}
  :root:not(.js) .ideat .q:not(.on){display:block}

  .moreb{margin-top:clamp(28px,4vw,56px)}
  .mh{display:flex; flex-wrap:wrap; justify-content:space-between; align-items:baseline; gap:10px 24px; padding:0 6px 16px}
  .mh h2{font-size:clamp(30px,3.4vw,48px); margin:0}
</style>

<script>
  // ── the working rides board ──
  const board = document.querySelector<HTMLElement>('[data-board]');
  if (board) {
    const toast = board.querySelector<HTMLElement>('.toast');
    if (toast) toast.textContent = 'Tap +1 on any ride to take a seat.';
    for (const li of board.querySelectorAll<HTMLElement>('li')) {
      const btn = li.querySelector('button')!;
      if (+li.dataset.n! >= +li.dataset.cap!) { btn.disabled = true; btn.textContent = 'Full'; btn.setAttribute('aria-label', `${li.querySelector('b')!.textContent} is full`); }
    }
    board.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest('button');
      if (!btn || btn.disabled) return;
      const li = btn.closest('li')!;
      const cap = +li.dataset.cap!;
      const joined = li.classList.toggle('in');
      const n = +li.dataset.n! + (joined ? 1 : -1);
      li.dataset.n = String(n);
      const s = li.querySelector<HTMLElement>('.s')!;
      s.textContent = `${n} of ${cap}`;
      s.classList.remove('pop'); void s.offsetWidth; s.classList.add('pop');
      btn.textContent = joined ? 'You’re in' : '+1';
      btn.setAttribute('aria-pressed', String(joined));
      const name = li.querySelector('b')!.textContent;
      if (toast) toast.innerHTML = joined
        ? `<b>Seat taken on ${name}.</b> Everyone looking at the board now sees ${n} of ${cap}.`
        : `Seat given back on ${name}.`;
    });
  }

  // ── Berkeley local time, so the tile is true whenever it's read ──
  const clock = document.querySelector<HTMLElement>('[data-clock]');
  if (clock) {
    const fmt = new Intl.DateTimeFormat('en-US', { timeZone: 'America/Los_Angeles', hour: 'numeric', minute: '2-digit', weekday: 'long' });
    const day = clock.parentElement?.querySelector<HTMLElement>('[data-day]');
    const tick = () => {
      const p = Object.fromEntries(fmt.formatToParts(new Date()).map((x) => [x.type, x.value]));
      clock.innerHTML = `${p.hour}<span class="colon">:</span>${p.minute}<small>${(p.dayPeriod || '').toLowerCase()}</small>`;
      if (day) day.textContent = p.weekday;
    };
    tick(); setInterval(tick, 10000);
  }

  // ── count the headline figure up the first time it is seen ──
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!reduce && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver((entries) => entries.forEach((en) => {
      if (!en.isIntersecting) return;
      io.unobserve(en.target);
      const el = en.target as HTMLElement, to = +el.dataset.count!, t0 = performance.now();
      const step = (t: number) => {
        const k = Math.min(1, (t - t0) / 1400);
        el.textContent = String(Math.round(to * (1 - Math.pow(1 - k, 4))));
        if (k < 1) requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
    }), { threshold: .6 });
    document.querySelectorAll('[data-count]').forEach((c) => io.observe(c));
  }

  // ── how I work, one idea at a time ──
  const box = document.querySelector<HTMLElement>('[data-ideas]');
  if (box) {
    const qs = Array.from(box.querySelectorAll<HTMLElement>('.q'));
    const n = box.querySelector<HTMLElement>('.n');
    let k = 0;
    box.querySelector('button')?.addEventListener('click', () => {
      qs[k].classList.remove('on');
      k = (k + 1) % qs.length;
      qs[k].classList.add('on', 'swap');
      qs[k].addEventListener('animationend', () => qs[k].classList.remove('swap'), { once: true });
      if (n) n.textContent = `${k + 1} / ${qs.length}`;
    });
  }
</script>
