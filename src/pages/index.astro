---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PinnedStory from '../components/PinnedStory.astro';
import { viz } from '../lib/viz';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const aws = projects.find((p) => p.id === 'action-hub')!;
const rest = projects.filter((p) => !p.data.featured);

// Shared with /work, so a project's drawing is defined once.

// Editorial narrative for the one cinematic moment — hand-written, not derived
// from card metrics, because the story is the point rather than the figures.
const tripmatchSteps = [
  { n: '5',        u: 'Non-goals, fixed before any code',
    d: 'No payments, no dispatch, no native app, no WhatsApp replacement, no open matching. Each was a deliberate cut, and the list is why the scope held.' },
  { n: '+1',       u: 'Had to mean exactly one thing',
    d: 'On a driver\u2019s post it read as either \u201cI want a seat\u201d or \u201cI\u2019m also driving that way\u201d, and nothing stopped six people claiming three seats. Until it meant one thing and the cap was enforced in the write, the number on a post counted nothing.' },
  { n: '1 tap',    u: 'From the group chat to the board',
    d: 'A link is the right form factor \u2014 no install, one tap from the chat the users are already in. That choice set the form factor, and later produced the nastiest bug in the project.' },
  { n: 'Verified', u: 'Berkeley-only, by design',
    d: 'Access is an email match against a verified account, enforced server-side. Opening it to strangers would have re-introduced exactly the trust problem the product exists to avoid.' },
];
---
<BaseLayout
  title="Eason Han"
  description="Product portfolio of Yichen (Eason) Han — MBA/MEng at UC Berkeley Haas, former AWS. 0-to-1 products, PRDs, and shipped code."
>
  <header class="hero wrap">
    <p class="eyebrow rv">Product management · Berkeley Haas</p>
    <h1 class="rv-w">Product thinking, and <span class="em">the hands to build it</span>.</h1>
    <p class="lede rv">
      MBA / MEng candidate at <strong>UC Berkeley Haas &amp; IEOR</strong>.
      Three years at <strong>AWS</strong> building analytics products for an $80B sales org.
    </p>
    <div class="chips rv">
      <a class="chip solid" href="/work">See the work</a>
      <a class="chip" href="https://www.linkedin.com/in/yichen-eason-han/">LinkedIn ↗</a>
      <a class="chip" href="mailto:eason_han@berkeley.edu">eason_han@berkeley.edu</a>
    </div>
  </header>

  <div class="strip">
    <div class="wrap">
      <div><span class="dot"></span>Seeking <b>Summer 2027 PM internship</b></div>
      <div>Focus <b>AI · Mobility · Consumer · Enterprise</b></div>
      <div>Based <b>Berkeley, CA</b></div>
    </div>
  </div>

  <PinnedStory
    eyebrow="01 — Shipped alone · Aug 2026"
    title="TripMatch"
    sub="A verified, Berkeley-only rides board for the Haas cohort — problem framing through production, alone. The part worth reading is what I wrote down that it would never do, and what broke when I tested it against its own launch load."
    href="/work/tripmatch"
    steps={tripmatchSteps}
  />

  <section class="sectionpad">
    <div class="wrap">
      <p class="eyebrow rv">02 — 0 → 1 at scale · AWS, 2023–2026</p>
      <h2 class="rv-w ahead">Two hundred dashboards.<br><span class="em">One place to start.</span></h2>
      <p class="sub rv ahead">
        The hard question was never what to display. It was what to put first — and what to say
        about it. An alert that names no next action moves the work rather than removing it.
      </p>

      <figure class="plate rv" style="margin-block:52px">
        <svg viewBox="0 0 880 300" role="img" aria-labelledby="ah-t">
          <title id="ah-t">A stack of overlapping dashboards with no agreed starting point, beside one ranked list where each row carries a named next action</title>
          <g id="ah-stack"></g>
          <text x="16" y="288" font-size="11" font-family="var(--mono)" fill="var(--ink-3)" letter-spacing="1.2">ROUGHLY 200 OF THESE. NO AGREED PLACE TO BEGIN.</text>
          <path d="M336 150 L392 150" stroke="var(--border-strong)" stroke-width="1.4"/>
          <path d="M392 150 l-9 -5 v10 z" fill="var(--border-strong)"/>
          <g transform="translate(412,38)" font-family="var(--display)">
            <rect x="0" y="-30" width="452" height="26" rx="4" fill="var(--ink)" opacity="0.07"/>
            <text x="12" y="-12" font-size="11" font-family="var(--mono)" fill="var(--ink-3)" letter-spacing="1.4">RANK = SEVERITY × ACCOUNT VALUE</text>
            <g><rect x="0" y="8" width="452" height="56" rx="5" fill="var(--panel)"/>
              <text x="18" y="34" font-size="14" font-weight="600" fill="#f4f2ef">Renewal risk · 3 accounts</text>
              <text x="18" y="53" font-size="12" fill="#a8b6c4">Next: schedule exec review this week</text>
              <circle cx="426" cy="36" r="4.5" fill="#e0685c"/></g>
            <g><rect x="0" y="74" width="452" height="56" rx="5" fill="var(--ink)" opacity="0.07"/>
              <text x="18" y="100" font-size="14" font-weight="600" fill="var(--ink)">Idle capacity · 7 accounts</text>
              <text x="18" y="119" font-size="12" fill="var(--ink-2)">Next: propose rightsizing plan</text>
              <circle cx="426" cy="102" r="4.5" fill="var(--gold)"/></g>
            <g><rect x="0" y="140" width="452" height="56" rx="5" fill="var(--ink)" opacity="0.07"/>
              <text x="18" y="166" font-size="14" font-weight="600" fill="var(--ink)">Support backlog · 2 accounts</text>
              <text x="18" y="185" font-size="12" fill="var(--ink-2)">Next: escalate to TAM</text>
              <circle cx="426" cy="168" r="4.5" fill="#4a7c7e"/></g>
            <text x="0" y="228" font-size="11" font-family="var(--mono)" fill="var(--ink-3)" letter-spacing="1.2">TIME-TO-INSIGHT −70%   ·   10,000+ SELLERS</text>
          </g>
        </svg>
        <figcaption>Redrawn for this portfolio — the product itself is internal</figcaption>
      </figure>

      <div class="chips rv"><a class="chip" href="/work/action-hub">Read the case study →</a></div>
    </div>
  </section>

  <section class="panel sectionpad">
    <div class="wrap">
      <p class="eyebrow rv">Everything else</p>
      <h2 class="rv-w">{rest.length} more.</h2>
      <div class="blocks">
        {rest.map((p, i) => (
          <a class="bk rv" href={`/work/${p.id}`}>
            <div class="glow" style={`background:${['#2f6fae','#4b63b8','#c99700','#2f8f6f','#2b6fa8','#8a5fae','#b0433f','#2f7f8f','#a8722b','#3f6f4f','#4b63b8'][i % 11]}`}></div>
            <span class="no">{String(i + 1).padStart(2, '0')}</span>
            {viz[p.id] && <span class="viz" set:html={viz[p.id]} />}
            <span class="t">{p.data.title}</span>
            {p.data.metrics.length > 0 && (
              <span class="m"><b>{p.data.metrics[0].n}</b> {p.data.metrics[0].l}</span>
            )}
          </a>
        ))}
      </div>
      <div class="chips rv" style="margin-top:34px"><a class="chip" href="/work">All work, filterable →</a></div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero{padding:104px 0 74px}
  /* the display column hangs on a left axis; figures break past it */
  @media (min-width:1000px){ .ahead{margin-left:7%} }
  @media (max-width:560px){ .hero{padding:62px 0 46px} }
</style>

<script>
  // Five dashboards cascading over one another: the point is that they all look
  // alike and none of them is the place to start. Deterministic, so it is the
  // same picture on every build.
  const stack = document.getElementById('ah-stack');
  if (stack) {
    const W = 184, H = 128, DX = 30, DY = 24;
    let out = '';
    for (let i = 0; i < 5; i++) {
      const x = 10 + i * DX, y = 6 + i * DY;
      const op = (0.42 + i * 0.145).toFixed(2);
      let g = `<g opacity="${op}">`;
      g += `<rect x="${x}" y="${y}" width="${W}" height="${H}" rx="5" fill="var(--surface)" stroke="var(--border-strong)"/>`;
      g += `<rect x="${x}" y="${y}" width="${W}" height="21" rx="5" fill="var(--ink)" opacity="0.055"/>`;
      g += `<rect x="${x + 9}" y="${y + 7}" width="${44 - i * 4}" height="6" rx="2" fill="var(--ink)" opacity="0.3"/>`;
      for (let d = 0; d < 3; d++) g += `<circle cx="${x + W - 12 - d * 9}" cy="${y + 10}" r="2" fill="var(--ink)" opacity="0.18"/>`;
      // three KPI tiles
      for (let k = 0; k < 3; k++) {
        g += `<rect x="${x + 9 + k * 56}" y="${y + 29}" width="50" height="22" rx="3" fill="var(--ink)" opacity="0.055"/>`;
        g += `<rect x="${x + 14 + k * 56}" y="${y + 35}" width="${18 + ((i * 7 + k * 5) % 16)}" height="5" rx="2" fill="var(--ink)" opacity="0.26"/>`;
      }
      // a bar chart that differs per dashboard but is stable per build
      for (let bI = 0; bI < 8; bI++) {
        const h = 8 + ((i * 13 + bI * 29) % 34);
        g += `<rect x="${x + 10 + bI * 16}" y="${y + H - 12 - h}" width="10" height="${h}" rx="2" fill="var(--ink)" opacity="0.17"/>`;
      }
      g += `<line x1="${x + 9}" y1="${y + 60}" x2="${x + W - 9}" y2="${y + 60}" stroke="var(--ink)" stroke-opacity="0.09"/>`;
      out += g + '</g>';
    }
    stack.innerHTML = out;
  }
</script>
