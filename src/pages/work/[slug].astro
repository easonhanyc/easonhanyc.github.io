---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props;
const d = project.data;
const { Content } = await render(project);

// Retitled projects carry their context after an em-dash. Setting that half in
// the serif accent keeps the name itself the thing you read first.
const [name, ...ctx] = d.title.split(' \u2014 ');
const context = ctx.join(' \u2014 ');

const artifacts = (await getCollection('artifacts'))
  .filter((a) => a.data.related === project.id)
  .sort((a, b) => a.data.order - b.data.order);
---
<BaseLayout title={`${d.title} · Eason Han`} description={d.description}>
  <div class="narrow">
    <div class="backbar"><a href="/work">← All work</a></div>

    <header class="dochead">
      <p class="eyebrow">{d.period}</p>
      <h1 class="rv-w" style="font-size:clamp(32px,5.6vw,62px)">{name}{context && <> <span class="em">{context}</span></>}</h1>
      <p class="docmeta">
        <span>{d.role}</span>
        {d.live && <span class="tag live">● Live</span>}
        {d.badges.map((b) => <span class="tag">{b}</span>)}
      </p>

      {d.metrics.length > 0 && (
        <div class="metricrow">
          {d.metrics.map((m) => (
            <div class="m"><span class="n">{m.n}</span><span class="l">{m.l}</span></div>
          ))}
        </div>
      )}

      {(d.links.live || d.links.code || d.links.prd) && (
        <div class="chips" style="margin:26px 0 8px">
          {d.links.live && <a class="chip solid" href={d.links.live} target="_blank" rel="noopener noreferrer" aria-label="Try it live (opens in a new tab)">Try it live ↗</a>}
          {d.links.code && <a class="chip" href={d.links.code} target="_blank" rel="noopener noreferrer" aria-label="Source (opens in a new tab)">Source ↗</a>}
          {d.links.prd && <a class="chip" href={d.links.prd}>The PRD →</a>}
        </div>
      )}
    </header>

    <article class="prose" style="margin-top:40px"><Content /></article>

    {artifacts.length > 0 && (
      <section style="margin-top:64px; padding-top:34px; border-top:1px solid var(--border)">
        <p class="eyebrow">Working documents</p>
        <div class="arts">
          {artifacts.map((a) => (
            <a class="art" href={`/artifacts/${a.id}`}>
              <span class="k">{a.data.kind}</span>
              <span class="t">{a.data.title}</span>
              <span class="d">{a.data.description}</span>
            </a>
          ))}
        </div>
      </section>
    )}

    <div style="padding:56px 0 20px"><a class="chip" href="/work">← All work</a></div>
  </div>
</BaseLayout>

<style>
  /* Rules rather than a boxed card, so the figures read as part of the
     header instead of an object sitting under it. */
  .metricrow{
    display:grid; grid-template-columns:repeat(auto-fit,minmax(128px,1fr));
    gap:0 26px; margin:30px 0 0; border-top:1px solid var(--border-strong);
  }
  .metricrow .m{padding:16px 0 2px}
  .metricrow .n{display:block; font-size:21px; font-weight:660; letter-spacing:-.015em; color:var(--ink); font-variant-numeric:tabular-nums}
  .metricrow .l{display:block; font-family:var(--mono); font-size:10.5px; color:var(--ink-3); margin-top:5px; line-height:1.4}
</style>
