---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Toc from '../../components/Toc.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props;
const d = project.data;
const { Content, headings } = await render(project);

// Retitled projects carry their context after an em-dash. The name is the
// headline; the context sits on its own line beneath it.
const [name, ...ctx] = d.title.split(' — ');
const context = ctx.join(' — ');

const artifacts = (await getCollection('artifacts'))
  .filter((a) => a.data.related === project.id)
  .sort((a, b) => a.data.order - b.data.order);
---
<BaseLayout title={`${d.title} · Eason Han`} description={d.description}>
  <div class="wrap">
    <div class="backbar"><a href="/work">← All work</a></div>

    <!-- A project opens the same way every time: where and when, the name,
         the role, then either the three-line summary or one paragraph. -->
    <header class="dochead">
      <p class="eyebrow rv">{d.org ?? 'Independent'} · {d.period}{d.live && ' · Live'}</p>
      <h1 class="rv">{name}</h1>
      {context && <p class="ctx rv">{context}</p>}
      <p class="role rv">{d.role}</p>

      {d.brief ? (
        <dl class="brief rv">
          <div><dt>The problem</dt><dd>{d.brief.problem}</dd></div>
          <div><dt>What I did</dt><dd>{d.brief.did}</dd></div>
          <div><dt>The result</dt><dd>{d.brief.result}</dd></div>
        </dl>
      ) : (
        <p class="lede rv">{d.summary}</p>
      )}

      {d.metrics.length > 0 && (
        <div class="figs rv">
          {d.metrics.map((m) => (
            <div><span class="n">{m.n}</span><span class="l">{m.l}</span></div>
          ))}
        </div>
      )}

      {(d.links.live || d.links.code || d.links.prd) && (
        <div class="chips rv">
          {d.links.live && <a class="chip solid" href={d.links.live} target="_blank" rel="noopener noreferrer" aria-label="Try it live (opens in a new tab)">Try it live ↗</a>}
          {d.links.code && <a class="chip" href={d.links.code} target="_blank" rel="noopener noreferrer" aria-label="Source (opens in a new tab)">Source ↗</a>}
          {d.links.prd && <a class="chip" href={d.links.prd}>The PRD →</a>}
        </div>
      )}
    </header>

    <div class="doc">
      <Toc headings={headings} />
      <article class="prose"><Content /></article>
    </div>

    {artifacts.length > 0 && (
      <section class="sec" aria-labelledby="docs-h">
        <header class="sec-h"><h2 id="docs-h">Working documents</h2></header>
        <ul class="rows">
          {artifacts.map((a) => (
            <li><a href={`/artifacts/${a.id}`}>
              <span class="lbl">{a.data.kind}</span>
              <span><span class="t">{a.data.title}</span><span class="d">{a.data.description}</span></span>
              <span class="arrow" aria-hidden="true">→</span>
            </a></li>
          ))}
        </ul>
      </section>
    )}

    <div class="docend"><a class="chip" href="/work">← All work</a></div>
  </div>
</BaseLayout>

<style>
  .dochead .lede{max-width:60ch; margin-bottom:clamp(28px,3.4vw,44px)}
</style>
